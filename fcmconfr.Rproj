Version: 1.0
ProjectId: 22eb1fe1-f11b-4d85-b4c8-22bf0ee3e854

RestoreWorkspace: No
SaveWorkspace: No
AlwaysSaveHistory: Default

EnableCodeIndexing: Yes
UseSpacesForTab: Yes
NumSpacesForTab: 2
Encoding: UTF-8

RnwWeave: Sweave
LaTeX: pdfLaTeX

AutoAppendNewline: Yes
StripTrailingWhitespace: Yes
LineEndingConversion: Posix

BuildType: Package
PackageUseDevtools: Yes
PackageInstallArgs: --no-multiarch --with-keep.source
PackageRoxygenize: rd,collate,namespace

PythonType: conda
PythonVersion: 3.13.0
PythonPath: ~/anaconda3/envs/fcm/bin/python3.13

ProjectName: fcmconfr
